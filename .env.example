# ───────────── FRONTEND (build-time, safe to expose) ─────────────
# URL of the backend. Leave empty for static hosting → the site runs in honest demo/offline mode
# (reservations are NOT sent, the assistant uses its built-in demo knowledge base).
VITE_API_BASE_URL=

# ───────────── BACKEND (server only — NEVER prefix with VITE_) ─────────────
PORT=8787
# Origin of the website allowed to call the API (CORS). Use your real domain in production.
ALLOWED_ORIGIN=https://your-domain.example

# AI assistant ("The Butcher's Guide"). Any OpenAI-compatible endpoint. Empty key = demo mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Reservation admin API (X-Admin-Token header). Admin API is disabled while empty.
ADMIN_TOKEN=
# Optional: Slack/Discord/Make/Zapier webhook that receives every new booking request.
RESERVATION_WEBHOOK_URL=
# Optional: path of the JSON database file (default backend/data/reservations.json).
RESERVATIONS_DB=
